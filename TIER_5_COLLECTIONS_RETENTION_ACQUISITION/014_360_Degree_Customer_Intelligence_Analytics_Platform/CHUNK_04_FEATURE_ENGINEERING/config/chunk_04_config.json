{
  "chunk_name": "CHUNK_04_FEATURE_ENGINEERING",
  "phase": "CRISP-DM Phase 3 - Data Preparation",
  "sprint": "AGILE Sprint 2 - Days 1-2",
  "version": "1.0.0",
  "objectives": [
    "Encode categorical variables",
    "Create new features (polynomial, interaction, ratio)",
    "Transform and scale features",
    "Select high-quality features",
    "Detect and remove redundant features",
    "Prepare data for modeling"
  ],
  "quality_gates": {
    "qg1_encoding": {
      "name": "Categorical Encoding",
      "expected_status": "PASSED",
      "criteria": "All categorical features encoded to numeric"
    },
    "qg2_feature_creation": {
      "name": "Feature Creation",
      "expected_status": "PASSED",
      "criteria": "New features created (polynomial, interaction, ratio)"
    },
    "qg3_transformation": {
      "name": "Feature Scaling & Transformation",
      "expected_status": "PASSED",
      "criteria": "All numeric features standardized"
    },
    "qg4_selection": {
      "name": "Feature Selection & Quality Assessment",
      "expected_status": "PASSED",
      "criteria": "High-variance features selected, redundancy detected"
    }
  },
  "encoding_config": {
    "label_encoding": {
      "enabled": true,
      "method": "ordinal",
      "description": "Maps categorical values to integers"
    },
    "one_hot_encoding": {
      "enabled": false,
      "drop_first": true,
      "description": "Available but not applied by default (increases dimensionality)"
    }
  },
  "feature_creation_config": {
    "polynomial_features": {
      "enabled": true,
      "degree": 2,
      "sample_size": 5,
      "description": "Create degree-2 polynomial features from top 5 numeric features"
    },
    "interaction_features": {
      "enabled": true,
      "pairs_count": 3,
      "description": "Create interaction features from numeric feature pairs"
    },
    "ratio_features": {
      "enabled": true,
      "pairs_count": 3,
      "description": "Create ratio features from numeric feature pairs"
    },
    "log_features": {
      "enabled": false,
      "description": "Available but not applied by default"
    }
  },
  "transformation_config": {
    "standardization": {
      "method": "z_score",
      "mean": 0,
      "std": 1,
      "enabled": true
    },
    "normalization": {
      "method": "minmax",
      "min": 0,
      "max": 1,
      "enabled": false
    },
    "log_transform": {
      "enabled": false,
      "description": "Available for positive-only features"
    }
  },
  "feature_selection_config": {
    "variance_based": {
      "enabled": true,
      "variance_threshold": 0.01,
      "description": "Select features with variance > threshold"
    },
    "correlation_based": {
      "enabled": false,
      "correlation_threshold": 0.05,
      "description": "Select features correlated with target"
    },
    "mutual_information": {
      "enabled": false,
      "k_features": 10,
      "description": "Select top k features by mutual information"
    },
    "redundancy_detection": {
      "enabled": true,
      "correlation_threshold": 0.95,
      "description": "Detect feature pairs with correlation > threshold"
    }
  },
  "input_source": {
    "chunk": "CHUNK_03_FEATURE_VALIDATION",
    "datasets": "All cleaned datasets from CHUNK_02"
  },
  "output_files": {
    "engineered_datasets": "Transformed datasets with new features",
    "feature_summary": "Feature creation and transformation summary",
    "selection_results": "High-variance features and redundancy report",
    "quality_metrics": "Quality assessment of engineered features"
  },
  "utility_library": {
    "location": "lib/feature_engineering.py",
    "classes": [
      "FeatureCreator",
      "CategoricalEncoder",
      "FeatureTransformer",
      "FeatureSelector",
      "FeatureQualityAssessor",
      "FeatureInteractionAnalyzer"
    ]
  },
  "next_chunk": "CHUNK_05_MODEL_SELECTION",
  "dependencies": {
    "python_packages": [
      "pandas>=1.3.0",
      "numpy>=1.21.0",
      "scikit-learn>=1.0.0"
    ],
    "input_data": [
      "All cleaned datasets from CHUNK_02"
    ]
  },
  "performance_notes": {
    "expected_execution_time_minutes": "2-3",
    "expected_feature_increase_percent": "20-40",
    "expected_memory_increase_mb": "50-200",
    "optimization": "Feature creation is parallelizable"
  }
}
